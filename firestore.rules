rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Authoritative active status check: requires document existence AND is_active == true
    function hasActiveAdminDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        getAdminDoc().data.is_active == true;
    }

    // Global administrators with unrestricted administrative access
    function isGlobalAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        (hasActiveAdminDoc() && (getAdminDoc().data.role == 'admin' || getAdminDoc().data.role == 'super_admin'))
      );
    }

    function getAdminBranchScope() {
      return request.auth.token.role == 'stadium_admin' ? 'فرع الاستاد' :
             request.auth.token.role == 'caravan_admin' ? 'فرع الكرفان' :
             hasActiveAdminDoc() ? getAdminDoc().data.scope : '';
    }

    // Validates whether the authenticated staff member has access to a specific branch
    function canAccessBranch(branchName) {
      return isGlobalAdmin() || (
        (hasActiveAdminDoc() && (getAdminBranchScope() == branchName || getAdminBranchScope() == 'all')) ||
        (request.auth.token.role == 'stadium_admin' && branchName == 'فرع الاستاد') ||
        (request.auth.token.role == 'caravan_admin' && branchName == 'فرع الكرفان')
      );
    }

    function isStaffMember() {
      return isAuthenticated() && (
        isGlobalAdmin() ||
        hasActiveAdminDoc() ||
        request.auth.token.role == 'stadium_admin' ||
        request.auth.token.role == 'caravan_admin' ||
        request.auth.token.role == 'kitchen' ||
        request.auth.token.role == 'staff'
      );
    }

    // Admins Collection - strictly restricted to Global Administrators
    // Individual admins can read their own document
    match /admins/{adminId} {
      allow read: if isGlobalAdmin() || (isAuthenticated() && request.auth.uid == adminId);
      allow write: if isGlobalAdmin();
    }

    // User Profiles - users can read/write their own profile; Global Admins can inspect
    match /user_profiles/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isGlobalAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Public Menu Collections (Categories, Option Groups, Options)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    match /option_groups/{groupId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    match /options/{optionId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    // Products - Public read; global admin write; branch admin can only update branch_availability
    match /products/{productId} {
      allow read: if true;
      allow write: if isGlobalAdmin() || (
        hasActiveAdminDoc() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branch_availability', 'updated_at'])
      );
    }

    // Restaurant Global Settings & Branches
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isGlobalAdmin() || (
        hasActiveAdminDoc() &&
        settingId == 'global' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branches', 'updated_at'])
      );
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    // Business Rules
    match /business_rules/{ruleId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Global staff can read all; branch admins can only read their own branch; customers only their own
      allow get: if isGlobalAdmin() ||
        (isStaffMember() && canAccessBranch(resource.data.branch)) ||
        (isAuthenticated() && resource.data.user_id == request.auth.uid);

      allow list: if isGlobalAdmin() ||
        (isStaffMember() && canAccessBranch(resource.data.branch)) ||
        (isAuthenticated() && resource.data.user_id == request.auth.uid);

      // Resilient & secure order creation:
      // Accepts new customer orders with strict validation (status must be 'new', total > 0, valid branch & phone)
      allow create: if request.resource.data.status == 'new' &&
                       request.resource.data.total > 0 &&
                       request.resource.data.customer_phone is string &&
                       request.resource.data.customer_phone.size() >= 8 &&
                       (request.resource.data.branch == 'فرع الاستاد' || request.resource.data.branch == 'فرع الكرفان') &&
                       request.resource.data.items is list &&
                       request.resource.data.items.size() > 0;

      // Staff can update only orders belonging to their branch, and cannot tamper with critical order fields
      // Also allow customer cancellation while order status is still 'new'
      allow update: if (
        ((isGlobalAdmin() || (isStaffMember() && canAccessBranch(resource.data.branch))) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updated_at', 'server_timestamp', 'kitchen_notes']) &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.customer_phone == resource.data.customer_phone &&
        request.resource.data.branch == resource.data.branch)
        ||
        (resource.data.status == 'new' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']))
      );

      // Allow deletion only by Global Admin for maintenance and clean reset
      allow delete: if isGlobalAdmin();
    }

    // Idempotency records - strictly managed by server transaction; cleanup allowed by Global Admin
    match /idempotency_records/{recordId} {
      allow read, write: if isGlobalAdmin();
    }

    // Counters collection (sequential order numbers) - server-managed with monotonic increment
    match /counters/{counterId} {
      allow read: if true;
      allow write: if isGlobalAdmin() || (
        counterId == 'order_counter' &&
        request.resource.data.current_number is int &&
        request.resource.data.current_number >= resource.data.current_number
      );
    }
  }
}
