rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        (request.auth.token.email == 'admin@pochinki.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'kitchen' ||
        request.auth.token.role == 'staff' ||
        (request.auth.token.email == 'admin@pochinki.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection - strictly restricted to administrators
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // User Profiles - users can read/write their own profile; admins can inspect
    match /user_profiles/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Public Menu Collections (Categories, Products, Option Groups, Options)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /option_groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Restaurant Global Settings & Branches
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business Rules (e.g. category-level minimum ordering quantity constraints)
    match /business_rules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

      // Orders Collection
    match /orders/{orderId} {
      // Staff can read all orders; authenticated users can only get their own
      allow get: if isStaff() || (
        isAuthenticated() && resource.data.user_id == request.auth.uid
      );

      // Authenticated users can only list orders matching their own user_id
      allow list: if isStaff() || (
        isAuthenticated() && resource.data.user_id == request.auth.uid
      );

      // Direct client creation is strictly forbidden.
      // All orders must be validated, priced, and created through the server-authoritative API.
      allow create: if false;

      // Only authorized staff can update status; customers cannot modify existing orders
      allow update: if isStaff();

      // Disallow deletion to preserve audit trails
      allow delete: if false;
    }

    // Idempotency records - strictly managed by server transaction
    match /idempotency_records/{recordId} {
      allow read, write: if false;
    }
  }
}
